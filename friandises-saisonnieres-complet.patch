+-- supabase-46-seasonal-events.sql
+--
+-- Friandises saisonnières activées automatiquement selon la date du jour.
+-- Les dates/items sont pilotés ici (Supabase), PAS dans le code de l'app :
+-- ajuster une date ou ajouter un item ne nécessite ni redéploiement web ni
+-- (surtout) resoumission Play Store — le client relit cette table à chaque
+-- ouverture de la Boutique / des sélecteurs de cadeaux.
+--
+-- start_date / end_date au format "MM-DD", comparés au jour courant côté
+-- client ET côté serveur (api/shop.js) avant d'autoriser un achat. Supporte
+-- le passage d'une année à l'autre (ex: "12-20" -> "01-05").
+
+create table if not exists seasonal_events (
+  id uuid primary key default gen_random_uuid(),
+  event_key text unique not null,
+  label text not null,
+  start_date text not null,  -- "MM-DD"
+  end_date text not null,    -- "MM-DD"
+  active boolean not null default true,  -- coupe-circuit manuel, indépendant des dates
+  items jsonb not null default '[]'::jsonb,
+  created_at timestamptz not null default now()
+);
+
+alter table seasonal_events enable row level security;
+
+-- Lecture publique (comme platform_settings) : le client a besoin de voir
+-- les items pour les afficher dans la Boutique. Aucune policy d'écriture
+-- publique — ajouts/modifs se font uniquement via l'éditeur SQL Supabase
+-- (service role), donc à la demande de Julien.
+drop policy if exists "seasonal_events_public_read" on seasonal_events;
+create policy "seasonal_events_public_read" on seasonal_events
+  for select using (true);
+
+-- ── Premier lot : Halloween, Noël, Saint-Valentin ──────────────────────────
+-- Chaque item : id (unique global, préfixé par événement pour éviter toute
+-- collision avec GIFT_CATALOG), emoji, label, amountCents, category, species
+-- (dog/cat/both), gender (accord grammatical déjà utilisé ailleurs dans
+-- l'app), premiumOnly optionnel.
+
+insert into seasonal_events (event_key, label, start_date, end_date, active, items) values
+(
+  'halloween',
+  'Halloween',
+  '10-15',
+  '11-02',
+  true,
+  '[
+    {"id": "halloween_dog_treat", "emoji": "🍬", "label": "Bonbon Effrayant", "amountCents": 99, "category": "food", "species": "dog", "gender": "m"},
+    {"id": "halloween_cat_treat", "emoji": "🦇", "label": "Chauve-Friand", "amountCents": 99, "category": "food", "species": "cat", "gender": "m"},
+    {"id": "halloween_premium_treat", "emoji": "🎃", "label": "Citrouille Gourmande", "amountCents": 299, "category": "food", "species": "both", "gender": "f", "premiumOnly": true}
+  ]'::jsonb
+),
+(
+  'noel',
+  'Noël',
+  '12-01',
+  '12-26',
+  true,
+  '[
+    {"id": "xmas_dog_treat", "emoji": "🍪", "label": "Biscuit de Noël", "amountCents": 99, "category": "food", "species": "dog", "gender": "m"},
+    {"id": "xmas_cat_treat", "emoji": "🍰", "label": "Bûche de Noël", "amountCents": 99, "category": "food", "species": "cat", "gender": "f"},
+    {"id": "xmas_premium_treat", "emoji": "🎄", "label": "Festin de Noël", "amountCents": 399, "category": "food", "species": "both", "gender": "m", "premiumOnly": true}
+  ]'::jsonb
+),
+(
+  'saint_valentin',
+  'Saint-Valentin',
+  '02-07',
+  '02-15',
+  true,
+  '[
+    {"id": "valentine_dog_treat", "emoji": "🍬", "label": "Câlin Croquant", "amountCents": 99, "category": "food", "species": "dog", "gender": "m"},
+    {"id": "valentine_cat_treat", "emoji": "🍫", "label": "Ronron d'Amour", "amountCents": 99, "category": "food", "species": "cat", "gender": "f"},
+    {"id": "valentine_premium_treat", "emoji": "💘", "label": "Coffret Romance", "amountCents": 299, "category": "food", "species": "both", "gender": "f", "premiumOnly": true}
+  ]'::jsonb
+)
+on conflict (event_key) do update set
+  label = excluded.label,
+  start_date = excluded.start_date,
+  end_date = excluded.end_date,
+  items = excluded.items;
